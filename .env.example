# ══════════════════════════════════════════
#   OpenAI
# ══════════════════════════════════════════
OPENAI_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_VERIFY_MODEL=gpt-4o
OPENAI_WHISPER=whisper-1

# Per-channel keys (optional — falls back to OPENAI_KEY)
OPENAI_KEY_WHATSAPP=
OPENAI_KEY_MESSENGER=
OPENAI_KEY_INSTAGRAM=

# ══════════════════════════════════════════
#   Facebook Messenger
# ══════════════════════════════════════════
FB_PAGE_ID=your_page_id
FB_PAGE_TOKEN=your_page_token
FB_APP_SECRET=your_app_secret
FB_VERIFY_TOKEN=your_verify_token

# ══════════════════════════════════════════
#   Instagram Messaging
# ══════════════════════════════════════════
IG_PAGE_ID=your_instagram_page_id
IG_PAGE_TOKEN=your_instagram_token
IG_APP_SECRET=your_app_secret
IG_VERIFY_TOKEN=your_verify_token

# ══════════════════════════════════════════
#   WhatsApp Cloud API
# ══════════════════════════════════════════
WA_PHONE_ID=your_phone_number_id
WA_TOKEN=your_whatsapp_token
WA_APP_SECRET=your_app_secret
WA_VERIFY_TOKEN=your_verify_token

# ══════════════════════════════════════════
#   Database
# ══════════════════════════════════════════
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4
CLEANUP_MEDIA_DAYS=7

# ══════════════════════════════════════════
#   Owner / Store
# ══════════════════════════════════════════
OWNER_PHONE=962XXXXXXXXX
OWNER_NAME=your_name
STORE_NAME=Your Store Name

# ══════════════════════════════════════════
#   Security & Dashboard
# ══════════════════════════════════════════
OWNER_API_KEY=your_api_key
INDEX_SECRET=your_secret_key

SMA_API_BASE=
SMA_API_KEY=
